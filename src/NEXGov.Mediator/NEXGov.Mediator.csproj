<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>NEXGov.Mediator</RootNamespace>
    <AssemblyName>NEXGov.Mediator</AssemblyName>
  </PropertyGroup>

  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>NEXGov.Mediator</PackageId>
    <Title>NEXMediator</Title>
    <Description>NEXMediator — an independent .NET mediator and CQRS library: requests, handlers, notifications, pipeline behaviors, and dependency injection. Establishes a clean-room, source-compatible V1 baseline with MediatR for familiar contracts and migration ease. Distributed as the NEXGov.Mediator package.</Description>
    <PackageTags>mediator;cqrs;mediatr;messaging;requests;notifications</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <!-- MED-031: canonical repository URL, confirmed via `git remote -v`
         (matches the SourceLink repository below and PublishRepositoryUrl's
         own auto-derived RepositoryUrl). -->
    <PackageProjectUrl>https://github.com/ismail8208/NEXGov.Mediator</PackageProjectUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <!-- MED-028: symbol package for step-through debugging of the published
         package, paired with SourceLink below. -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <!-- MED-028: repository confirmed as GitHub via `git remote -v`
         (github.com/ismail8208/NEXGov.Mediator). Build-time only — maps
         portable-PDB source paths to the repository so a debugger can step
         into NEXGov.Mediator's own source from a consumer project; never
         becomes a dependency of a consumer of this package. -->
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <!-- MED-015: lets NEXGov.Mediator.UnitTests exercise HandlerPriorityOrderer
         directly. Build-time only — internal members stay internal to every
         consumer outside this one named test assembly; adds no public API. -->
    <InternalsVisibleTo Include="NEXGov.Mediator.UnitTests" />
  </ItemGroup>

</Project>
